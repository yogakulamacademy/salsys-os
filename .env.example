# Supabase browser-safe values from Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = fictional local data, no login required.
# false = real Supabase Auth + CRM data.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Canonical public SalsysOS origin used for security-sensitive absolute URLs
# such as Supabase password recovery callbacks. Required in production.
# Production canonical origin: https://salsysos.com
SALSYSOS_APP_URL=

# Server-only key for website tracking ingestion. Prefer the newer Supabase secret key when available.
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins permitted to POST website tracking events.
TRACKING_ALLOWED_ORIGINS=https://www.yogakulam.com,https://yogakulam.com,https://www.yogakulamacademy.com,https://yogakulamacademy.com,http://localhost:3000

# Random server-to-server secret used only when linking an anonymous visitor journey to a CRM lead.
TRACKING_INGEST_SECRET=

# Server-to-server secret used by yogakulam.com / yogakulamacademy.com PHP backends
# when they POST a successfully saved enquiry to /api/leads/capture.
# Generate a long random value and use the same value on Vercel and the website server.
WEBSITE_LEAD_CAPTURE_SECRET=

# Claude is used only to analyze grounded SEO/AEO/GEO evidence and generate recommendations.
# It is never treated as the source of ranking truth.
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=
ANTHROPIC_HAIKU_MODEL=

# Optional external live ranking/visibility provider adapter.
# The provider endpoint must accept POST JSON containing query, surface, locale,
# country_code, device and engine, and return normalized SEO/AEO/GEO observations.
SEO_RANKING_API_URL=
SEO_RANKING_API_KEY=
