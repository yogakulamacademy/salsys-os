# Supabase browser-safe values from Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = fictional local data, no login required.
# false = real Supabase Auth + CRM data.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Canonical public SalsysOS origin used for security-sensitive absolute URLs
# such as Supabase password recovery callbacks. Required in production.
# Production canonical origin: https://salsysos.com
SALSYSOS_APP_URL=

# Server-only key for website tracking ingestion. Prefer the newer Supabase secret key when available.
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins permitted to POST website tracking events.
TRACKING_ALLOWED_ORIGINS=https://www.yogakulam.com,https://yogakulam.com,https://www.yogakulamacademy.com,https://yogakulamacademy.com,http://localhost:3000

# Random server-to-server secret used only when linking an anonymous visitor journey to a CRM lead.
TRACKING_INGEST_SECRET=

# Server-to-server secret used by yogakulam.com / yogakulamacademy.com PHP backends
# when they POST a successfully saved enquiry to /api/leads/capture.
# Generate a long random value and use the same value on Vercel and the website server.
WEBSITE_LEAD_CAPTURE_SECRET=

# Optional read-only operator pilot for independently deployed open-source engines.
# No data syncing, webhook registration, message sending, redirect or SSO is enabled.
# Do not enable as evidence of a completed migration.
SALSYS_VENDOR_WORKSPACE_PREVIEW=false
# Use HTTPS base URLs with no credentials, query or fragment.
SALSYS_OPENSEO_URL=
SALSYS_DESKCOMM_URL=
# Read-only OpenSEO MCP project inventory (zero-credit list_projects).
# A key is tied to one OpenSEO organization and must not be shared across SalsysOS tenants.
# Set to the EXACT SalsysOS organization UUID allowed to use this key; otherwise fail closed.
SALSYS_OPENSEO_SALSYS_ORG_ID=
# Create in OpenSEO -> Settings -> API keys. Never use NEXT_PUBLIC_ for this secret.
SALSYS_OPENSEO_API_KEY=

# Deskcomm-inspired WhatsApp inbound channel shadow (safe pilot).
# False by default. Does not send, replay, assign, or update customer consent.
# When enabled, categorical, PII-free classifications are attached to NEW
# canonical WhatsApp raw events after successful Meta signature + tenant binding.
SALSYS_DESKCOMM_INBOUND_SHADOW=false

# Optional human-review task actions on verified WhatsApp handoff candidates.
# Keep OFF until the migration, owner/admin audit, scheduler and provider-send
# gates pass isolated staging tests. Also requires inbound shadow mode=true.
# No webhook automatically invokes these actions or restarts cancelled jobs.
SALSYS_DESKCOMM_HANDOFF_ACTIONS=false


# Sales AI Autopilot (live replies on Instagram). Off unless "true".
AI_AUTOPILOT_LIVE_ENABLED=
# ISO time; only leads created after this are enrolled as new-lead pilots.
AI_AUTOPILOT_PILOT_START=
# Max new leads Autopilot may enrol per IST day (default 20).
AI_AUTOPILOT_DAILY_NEW_LEADS=
# Draft due follow-up messages on AI follow-up tasks.
AI_FOLLOWUP_DRAFTS_ENABLED=

# R13 manual-first pilot. All switches OFF until approved isolated rehearsal.
# Do not turn off access enforcement for existing self-signup customers.
SALSYS_PUBLIC_SIGNUP_ENABLED=false
# Explicit admission mode: closed, pilot (up to 10 exact verified emails), public.
SALSYS_SIGNUP_ADMISSION_MODE=closed
SALSYS_SIGNUP_PILOT_EMAILS=
SALSYS_COMMERCIAL_ACCESS_ENABLED=false
SALSYS_TRIAL_RECONCILIATION_ENABLED=false
SALSYS_SIGNUP_TURNSTILE_SITE_KEY=
SALSYS_SIGNUP_TURNSTILE_SECRET=
SALSYS_PLAN_ADMIN_ENABLED=false
SALSYS_COMMERCIAL_PLATFORM_ORG_ID=
SALSYS_PLAN_PUBLICATION_ENABLED=false
SALSYS_PLAN_CHANGE_REQUESTS_ENABLED=false
SALSYS_MANUAL_PILOT_ENABLED=false
SALSYS_MANUAL_ACTIVATION_ENABLED=false
SALSYS_MANUAL_RECONCILIATION_ENABLED=false
# Payment gateway deferred. Non-binding quote workflow also not required.
SALSYS_CONTRACT_QUOTES_ENABLED=false
# Server-only scheduler secret; use a unique high-entropy value.
CRON_SECRET=
